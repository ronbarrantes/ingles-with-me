# /bot: the conversation partner. Set these in Vercel (Project → Settings →
# Environment Variables) or in a local .env file. Never commit real values.

# Required: protects /bot so strangers can't spend your money.
BOT_PASSCODE=

# The teacher (Claude). Required for real replies.
ANTHROPIC_API_KEY=
# Optional: which Claude model teaches. Default: claude-sonnet-5-5
# (try claude-haiku-5-5 or claude-opus-5-5).
TUTOR_MODEL=

# Ears + voice (Azure AI Speech). Without these, /bot falls back to the
# phone's own recognition and voice, with no pronunciation scores.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Testing only: 1 = canned replies, no API calls.
TUTOR_MOCK=
