# /bot: the conversation partner. Set these in Vercel (Project → Settings →
# Environment Variables) or in a local .env file. Never commit real values.

# Required: protects /bot so strangers can't spend your money.
BOT_PASSCODE=

# Each role is "provider:model". Swap any of them without code changes.
#   teacher: anthropic:claude-sonnet-5-5 | anthropic:claude-haiku-5-5 |
#            anthropic:claude-opus-5-5   | google:<gemini model id>
#   judge:   google:<gemini model id>  (hears her + scores pronunciation)
#   voice:   google:<Google TTS voice name>
TEACHER=anthropic:claude-sonnet-5-5
JUDGE=google:gemini-4-hydrogen
# How hard the judge thinks: minimal (default) | off (none, if the model allows) | low | medium | high | default
# JUDGE_THINKING=minimal
# Fast Chirp voice (default); Spanish parts use the same voice in es-US.
VOICE=google:en-US-Chirp3-HD-Aoede
#   VOICE_ES=google:es-US-Chirp3-HD-Aoede
# One multilingual Gemini voice instead (slower, rate-limited):
#   VOICE=gemini:gemini-2.5-flash-tts/Aoede
# The Gemini voice is slower, so it only speaks lines with Spanish in them;
# English-only lines use Chirp. Set VOICE_GEMINI_ALWAYS=1 to use it for everything.

# Anthropic (for an anthropic: teacher).
ANTHROPIC_API_KEY=

# Google Cloud (Vertex AI for Gemini, plus Text-to-Speech): the whole JSON
# key of a service account, pasted as one value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: defaults to the key's project / "global".
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Testing only: 1 = canned replies and scores, no API calls.
BOT_MOCK=

# Analytics and error tracking (PostHog). The key is public (starts with phc_).
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
